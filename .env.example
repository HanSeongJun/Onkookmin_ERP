# ------------------------------------------------------------------
# Supabase 연결 정보 (설정 견본 파일)
#
# 사용 방법:
#   1) 이 파일을 복사해서 .env.local 파일을 만듭니다.
#        cp .env.example .env.local
#   2) .env.local 을 열어 아래 두 값의 = 뒤에 실제 값을 붙여 넣습니다.
#
# - 이 파일(.env.example)에는 실제 값을 넣지 마세요. 견본이라 git에 올라갑니다.
# - .env.local 은 git에 올라가지 않습니다.
# - 값을 바꾼 뒤에는 npm run dev 를 껐다가(Ctrl + C) 다시 켜야 적용됩니다.
# ------------------------------------------------------------------

# 프로젝트 URL
# 찾는 곳: Supabase 대시보드 → 프로젝트 선택 → Project Settings(톱니바퀴) → Data API → "Project URL"
# 예시: https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (공개용 키 — 브라우저에 보여도 괜찮은 키입니다)
# 찾는 곳: Supabase 대시보드 → Project Settings(톱니바퀴) → API Keys → "Publishable key" 복사
# "sb_publishable_" 로 시작합니다.
# (예전에 만든 프로젝트라 publishable key가 없다면, 같은 화면의 Legacy 탭에 있는 "anon public" 키를 넣어도 됩니다.)
# 주의: "Secret key"(sb_secret_ 로 시작)나 service_role 키는 절대 넣지 마세요.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
